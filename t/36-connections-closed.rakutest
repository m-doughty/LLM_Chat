use Test;
use lib 'lib';

use LLM::Chat::Backend::KoboldCpp;
use LLM::Chat::Backend::OpenAICommon;
use LLM::Chat::Backend::OpenRouter;
use LLM::Chat::Backend::Response;
use LLM::Chat::Backend::Settings;
use LLM::Chat::Conversation::Message;
use LLM::Chat::Template::ChatML;

use JSON::Fast;

# No request leaves its connection open.
#
# Every request builds a Cro::HTTP::Client of its own and drops it when
# the response is in. Cro's clients are persistent by default: a
# finished response hands its connection to the client's pool, for the
# next request to the same host — and with the client dropped, nothing
# ever draws on that pool or closes it. Each request left a socket open
# for the life of the process. Under the 256 file descriptors a macOS
# shell allows by default, t/21's few hundred requests ran out part-way
# through; a long chat session or a batch run does the same, only
# slower.
#
# The fixture is a raw HTTP/1.1 server that keeps each connection open,
# as HTTP/1.1 does by default, unless the request carries
# `Connection: close`. Then it closes the connection after its answer,
# as RFC 9112 requires of a server. That header is how a non-persistent
# Cro client ends a connection: Cro never closes one itself, it asks the
# server to. The server counts the connections that are open, from
# accept until either side closes. Each path below makes REQUESTS
# requests in turn, checks that every one got the fixture's real answer
# (so nothing passes for want of a request), and then that no
# connection is left open.

plan 9;

my constant REQUESTS = 20;

# How long the last closes may take to land once the requests are done:
# a failsafe, not a timing assumption; they land in milliseconds.
my constant CLOSE-LIMIT = 30;

# How long one request may take before it counts as lost.
my constant SETTLE-LIMIT = 30;

my constant CHAT-SSE =
	'data: {"choices":[{"delta":{"content":"hello"},"finish_reason":null}]}' ~ "\n\n"
	~ 'data: {"choices":[{"delta":{},"finish_reason":"stop"}]}' ~ "\n\n"
	~ "data: [DONE]\n\n";

my constant TEXT-SSE =
	'data: {"choices":[{"text":"hello","finish_reason":"stop"}]}' ~ "\n\n"
	~ "data: [DONE]\n\n";

# The fixture's answer to each request, by method and path (query string
# dropped): a content type and a body.
sub answer(Str:D $method, Str:D $path, Str:D $body --> List) {
	my Bool $stream = $body.contains('"stream":true');
	given "$method $path" {
		when 'POST /v1/chat/completions' {
			$stream
				?? ('text/event-stream', CHAT-SSE)
				!! ('application/json', to-json(%(
					id      => 'gen-36',
					choices => [
						%(
							message       => %( role => 'assistant', content => 'hello' ),
							finish_reason => 'stop',
						),
					],
				), :!pretty));
		}
		when 'POST /v1/completions' {
			$stream
				?? ('text/event-stream', TEXT-SSE)
				!! ('application/json',
					'{"choices":[{"text":"hello","finish_reason":"stop"}]}');
		}
		when 'GET /props' {
			('application/json', '{"default_generation_settings":{"n_ctx":4096}}');
		}
		when 'GET /slots' {
			('application/json', '[{"id":0},{"id":1}]');
		}
		when 'GET /api/extra/true_max_context_length' {
			('application/json', '{"value":8192}');
		}
		when 'GET /api/extra/perf' {
			('application/json', '{"stop_reason":2,"last_token_count":3}');
		}
		when 'POST /api/extra/abort' {
			('application/json', '{"success":true}');
		}
		when 'GET /v1/generation' {
			('application/json', '{"data":{"total_cost":0.25}}');
		}
		default {
			('application/json', '{}');
		}
	}
}

# A keep-alive HTTP/1.1 server that counts its open connections.
class KeepAliveServer {
	has $.port;
	has Int $!open = 0;
	has Int $!accepted = 0;
	has @!requests;
	has @!conns;
	has $!tap;
	has Lock $!lock = Lock.new;

	method start() {
		$!tap = IO::Socket::Async.listen('127.0.0.1', 0).tap(
			-> $conn { self!serve($conn) },
			quit => -> $ { },
		);
		$!port = await $!tap.socket-port;
		self;
	}

	method open(--> Int:D)     { $!lock.protect: { $!open } }
	method accepted(--> Int:D) { $!lock.protect: { $!accepted } }
	method requests(--> List)  { $!lock.protect: { @!requests.List } }

	method stop() {
		my @conns = $!lock.protect: { @!conns.List };
		for @conns -> $conn { try $conn.close }
		$!tap.close;
	}

	method !serve($conn) {
		$!lock.protect: {
			@!conns.push($conn);
			$!open++;
			$!accepted++;
		};
		my Bool $ended = False;
		# Counted once, whichever side closes first.
		my &ended = {
			$!lock.protect: {
				unless $ended {
					$ended = True;
					$!open--;
				}
			}
		};
		my Buf $pending = Buf.new;
		my Bool $closing = False;
		$conn.Supply(:bin).tap(
			-> $bytes {
				$pending.append($bytes);
				until $closing {
					my %request = take-request($pending);
					last unless %request;
					$!lock.protect: { @!requests.push("%request<method> %request<path>") };
					my ($type, $text) = answer(%request<method>, %request<path>, %request<body>);
					my Blob $body = $text.encode('utf-8');
					$closing = %request<close>;
					my Blob $head = (
						"HTTP/1.1 200 OK\r\n"
						~ "Content-Type: $type\r\n"
						~ "Content-Length: {$body.bytes}\r\n"
						~ ($closing ?? "Connection: close\r\n" !! '')
						~ "\r\n"
					).encode('latin-1');
					my $written = $conn.write($head ~ $body);
					$written.then({ $conn.close; ended() }) if $closing;
				}
			},
			done => &ended,
			quit => -> $ { ended() },
		);
	}
}

# Take the first complete request off the front of $pending and return
# it (method, path without query string, body, and whether it asked for
# Connection: close), or an empty Hash while it is still incomplete. Byte
# arithmetic on the Buf throughout: decoded, "\r\n" is one grapheme.
sub take-request(Buf:D $pending --> Hash:D) {
	my $head-end = header-end($pending);
	return %() without $head-end;
	my Str $head = $pending.subbuf(0, $head-end).decode('latin-1');
	my Int $length = $head ~~ m:i/ ^^ 'content-length:' \h* (\d+) / ?? +$0 !! 0;
	my Int $end = $head-end + 4 + $length;
	return %() if $pending.elems < $end;
	my Str $body = $pending.subbuf($head-end + 4, $length).decode('utf-8');
	$pending.splice(0, $end);
	my $line = $head ~~ / ^ (\S+) \s+ (<-[\s?]>+) /;
	%(
		method => $line ?? ~$line[0] !! '',
		path   => $line ?? ~$line[1] !! '/',
		body   => $body,
		close  => so $head ~~ m:i/ ^^ 'connection:' \h* 'close' \h* $$ /,
	);
}

sub header-end(Buf:D $buffer --> Int) {
	for 0 .. $buffer.elems - 4 -> $i {
		return $i if $buffer[$i] == 13 && $buffer[$i + 1] == 10
			&& $buffer[$i + 2] == 13 && $buffer[$i + 3] == 10;
	}
	Int;
}

sub settings() {
	LLM::Chat::Backend::Settings.new(max_tokens => 16);
}

sub user-turn() {
	[LLM::Chat::Conversation::Message.new(role => 'user', content => 'hi'),]
}

# A Response's own tap sets .is-done for success and failure alike, so
# polling it is race-free for blocking and streaming Responses both.
sub settled($response) {
	my $deadline = now + SETTLE-LIMIT;
	sleep 0.002 until $response.is-done || now > $deadline;
	$response;
}

# Make REQUESTS calls of &call, one after another, against a fresh
# server handed to &backend-for; then check that every call got the
# fixture's answer, that the requests reached the server, and that no
# connection is left open once the closes have landed. &call returns ''
# when its call got the answer, and otherwise says what it got instead,
# which is reported if the check fails.
sub closes-every-connection(Str:D $what, &backend-for, &call, *@expected-requests) {
	subtest "$what leaves no connection open" => {
		plan 4;
		my $server = KeepAliveServer.new.start;
		LEAVE { $server.stop }
		my $backend = backend-for($server.port);

		my @problems = (1 .. REQUESTS).map(-> $n {
			my Str:D $problem = call($backend);
			$problem.chars ?? "call $n: $problem" !! Empty;
		});
		is @problems.elems, 0, "all {REQUESTS} calls got the fixture's answer";
		diag $_ for @problems;

		my @seen = $server.requests;
		is-deeply @seen.unique.List, @expected-requests.List,
			"each call made {@expected-requests.join(' + ')}";
		is $server.accepted, REQUESTS * @expected-requests,
			'one connection per request';

		my $deadline = now + CLOSE-LIMIT;
		sleep 0.01 until $server.open == 0 || now > $deadline;
		is $server.open, 0, 'no connection is left open';
	};
}

sub openai(Int:D $port) {
	LLM::Chat::Backend::OpenAICommon.new(
		api_url  => "http://127.0.0.1:$port/v1",
		settings => settings(),
		template => LLM::Chat::Template::ChatML.new,
	);
}

sub koboldcpp(Int:D $port) {
	LLM::Chat::Backend::KoboldCpp.new(
		api_url  => "http://127.0.0.1:$port/v1",
		settings => settings(),
		template => LLM::Chat::Template::ChatML.new,
	);
}

sub openrouter(Int:D $port) {
	LLM::Chat::Backend::OpenRouter.new(
		api_url  => "http://127.0.0.1:$port/v1",
		settings => settings(),
		model    => 'test/model',
		api_key  => 'test-key',
	);
}

# '' when a completion settled on the fixture's "hello"; otherwise how
# it ended instead.
sub hello-problem($response --> Str:D) {
	settled($response);
	return '' if $response.is-success && ($response.msg // '') eq 'hello';
	my $err = $response.err;
	"done={$response.is-done} success={$response.is-success} "
		~ "msg={($response.msg // '').raku} "
		~ "err={$err.defined ?? ((try ~$err) // $err.^name).raku !! '-'} "
		~ "error-class={$response.error-class // '-'} "
		~ "error-status={$response.error-status // '-'} "
		~ "finish-reason={$response.finish-reason // '-'}";
}

closes-every-connection 'chat-completion', &openai,
	-> $backend { hello-problem($backend.chat-completion(user-turn())) },
	'POST /v1/chat/completions';

closes-every-connection 'chat-completion-stream', &openai,
	-> $backend { hello-problem($backend.chat-completion-stream(user-turn())) },
	'POST /v1/chat/completions';

closes-every-connection 'text-completion', &openai,
	-> $backend { hello-problem($backend.text-completion(user-turn())) },
	'POST /v1/completions';

closes-every-connection 'text-completion-stream', &openai,
	-> $backend { hello-problem($backend.text-completion-stream(user-turn())) },
	'POST /v1/completions';

closes-every-connection 'probe-server-limits', &openai,
	-> $backend {
		my %limits = $backend.probe-server-limits;
		(%limits<context_length> // 0) == 4096 && (%limits<slots> // 0) == 2
			?? '' !! "limits {%limits.sort.raku}";
	},
	'GET /props', 'GET /slots';

closes-every-connection 'KoboldCpp probe-server-limits', &koboldcpp,
	-> $backend {
		my %limits = $backend.probe-server-limits;
		(%limits<context_length> // 0) == 8192 ?? '' !! "limits {%limits.sort.raku}";
	},
	'GET /api/extra/true_max_context_length';

closes-every-connection "KoboldCpp's length check", &koboldcpp,
	-> $backend {
		my $response = LLM::Chat::Backend::Response.new(id => 'length-check');
		my $verdict = $backend._reconcile-finish-reason($response, 'length', %(max_tokens => 16));
		$verdict eq 'stop'
			?? '' !! "verdict $verdict, evidence {$response.finish-reason-evidence.sort.raku}";
	},
	'GET /api/extra/perf';

closes-every-connection "KoboldCpp's abort", &koboldcpp,
	-> $backend {
		my $abort = $backend.cancel(LLM::Chat::Backend::Response.new(id => 'abort'));
		await Promise.anyof($abort, Promise.in(SETTLE-LIMIT));
		given $abort.status {
			when Kept   { ($abort.result.?status // 0) == 200 ?? '' !! "abort answered {$abort.result.raku}" }
			when Broken { "abort failed: {$abort.cause.^name}" }
			default     { "abort still pending after {SETTLE-LIMIT}s" }
		}
	},
	'POST /api/extra/abort';

closes-every-connection "OpenRouter's generation lookup", &openrouter,
	-> $backend {
		my $response = $backend.chat-completion(user-turn());
		my $problem = hello-problem($response);
		$problem || (($response.cost // 0) == 0.25 ?? '' !! "cost {($response.cost // 'none').raku}");
	},
	'POST /v1/chat/completions', 'GET /v1/generation';

done-testing;
