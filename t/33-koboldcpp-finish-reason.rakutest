use Test;
use lib 'lib';

use LLM::Chat::Test::Kit;
use LLM::Chat::Backend::KoboldCpp;
use LLM::Chat::Backend::Settings;
use LLM::Chat::Conversation::Message;
use LLM::Chat::Template::ChatML;

use JSON::Fast;

# KoboldCpp's OpenAI-compatible endpoints report every stop that is not
# an end-of-sequence token as finish_reason "length":
#
#     currfinishreason = "error" if sr==-2 else ("length" if (sr!=1) else "stop")
#
# (koboldcpp.py, both the blocking and the streaming paths). A
# generation that ended on a custom stop sequence — stop_reason 2,
# CUSTOM_STOPPER in its expose.h — therefore arrived labelled as
# truncated, and a caller that treats `length` as failure (every
# streaming path here does) threw away a complete reply. After a tool
# result, KoboldCpp's emulated tool calling commonly ends that way with
# an output of "" or "\n".
#
# The backend now checks GET /api/extra/perf when it sees `length`.
# That endpoint describes the server's LAST generation — no request id
# — so the answer is only believed when it matches: stop_reason 2 and a
# last_token_count equal to the usage completion_tokens, or, when the
# stream carried no usage (KoboldCpp's tool-call streams never do), a
# count well under max_tokens. Anything else leaves `length`.
#
# The fixture is a real HTTP server playing KoboldCpp: scripted
# completions under /<name>/v1 and a scripted /<name>/api/extra/perf.
# It is LLM::Chat::Test::Kit's raw server.

plan 14;

class FakeKobold {
	has      $.server;
	has Int  $.port;
	has      %!scripts;
	has      %!blocking;
	has      %!perf;
	has      %!perf-hits;
	has      %!perf-auth;
	has      %!perf-paths;
	has Promise $.release .= new;
	has Lock $!lock .= new;

	method script(Str:D $name, *@frames --> FakeKobold) {
		$!lock.protect: { %!scripts{$name} = @frames.List };
		self;
	}

	method json(Str:D $name, %body --> FakeKobold) {
		$!lock.protect: { %!blocking{$name} = to-json(%body, :!pretty) };
		self;
	}

    #| What /api/extra/perf answers: a Hash (the JSON reply), or one of
    #| 'http-500', 'not-json', 'array', 'hang'.
	method perf(Str:D $name, $answer --> FakeKobold) {
		$!lock.protect: { %!perf{$name} = $answer };
		self;
	}

	method perf-hits(Str:D $name --> Int:D) { $!lock.protect: { %!perf-hits{$name} // 0 } }
	method perf-auth(Str:D $name) { $!lock.protect: { %!perf-auth{$name} } }
	method perf-path(Str:D $name) { $!lock.protect: { %!perf-paths{$name} } }

	method !sse(Str:D $name --> Supply) {
		my $frames = $!lock.protect: { %!scripts{$name} };
		supply {
			emit "data: $_\n\n".encode('utf-8') for $frames.list;
			done;
		}
	}

	method start(--> FakeKobold) {
		$!server = raw-server(-> $request { self!answer($request) });
		$!port = $!server.port;
		self;
	}

	method !answer($request --> Hash:D) {
		with $request.path ~~ / ^ '/' (<-[/]>+) '/v1/' [ 'chat/' ]? 'completions' $ / -> $route {
			my $name = ~$route[0];
			return $request.json<stream>
				?? %( type => 'text/event-stream', chunks => self!sse($name) )
				!! %( body => $!lock.protect({ %!blocking{$name} }) );
		}
		with $request.path ~~ / ^ '/' (<-[/]>+) '/api/extra/perf' $ / -> $route {
			my $name = ~$route[0];
			my $answer = $!lock.protect: {
				%!perf-hits{$name}++;
				%!perf-auth{$name} = $request.header('authorization');
				%!perf-paths{$name} = $request.path ~ ($request.query ?? "?{$request.query}" !! '');
				%!perf{$name};
			};
			return do given $answer {
				when Associative { %( body => to-json($answer, :!pretty) ) }
				when 'http-500'  { %( status => 500, body => '{"error":"boom"}' ) }
				when 'not-json'  { %( type => 'text/plain', body => 'KoboldCpp is thinking' ) }
				when 'array'     { %( body => '[2,3]' ) }
				when 'hang'      { %( delay => Promise.anyof($!release, Promise.in(30)), body => '{}' ) }
				default          { %( status => 404, body => '' ) }
			};
		}
		%( status => 404, body => '' );
	}

	method stop(--> Nil) {
		$!release.keep(True) unless $!release.status;
		$!server.stop with $!server;
		Nil;
	}
}

# A KoboldCpp /api/extra/perf reply, with the fields around the two that
# matter so the parse is exercised against the real shape.
sub perf(Int:D :$stop-reason!, Int:D :$count! --> Hash:D) {
	%(
		last_process => 0.5, last_eval => 0.02, last_token_count => $count,
		last_input_count => 900, last_process_time => 0.45, last_eval_time => 0.06,
		last_process_speed => 2000.0, last_eval_speed => 50.0, last_seed => 1234,
		last_draft_success => 0, last_draft_failed => 0, total_gens => 17,
		stop_reason => $stop-reason, total_img_gens => 0, total_tts_gens => 0,
		total_transcribe_gens => 0, queue => 0, idle => 1, hordeexitcounter => 0,
		uptime => 1000.0, idletime => 0.1, quiet => False,
	);
}

sub chat(Str:D $content, $reason = Nil --> Str:D) {
	to-json({ id => 'koboldcpp', object => 'chat.completion.chunk',
		choices => [ { index => 0, delta => { content => $content }, finish_reason => $reason }, ] }, :!pretty);
}

sub text(Str:D $text, $reason = Nil --> Str:D) {
	to-json({ object => 'text_completion',
		choices => [ { index => 0, text => $text, finish_reason => $reason }, ] }, :!pretty);
}

sub usage(Int:D $prompt, Int:D $completion --> Str:D) {
	to-json({ id => 'koboldcpp', object => 'chat.completion.chunk', model => 'koboldcpp/test', choices => [],
		usage => { prompt_tokens => $prompt, completion_tokens => $completion, total_tokens => $prompt + $completion } },
		:!pretty);
}

my $kobold = FakeKobold.new.start;
LEAVE { $kobold.stop }

sub backend(Str:D $name, Int :$max-tokens = 64, *%extra) {
	LLM::Chat::Backend::KoboldCpp.new(
		api_url              => "http://127.0.0.1:{$kobold.port}/$name/v1",
		settings             => LLM::Chat::Backend::Settings.new(max_tokens => $max-tokens),
		template             => LLM::Chat::Template::ChatML.new,
		request-stream-usage => True,
		|%extra,
	);
}

sub turn() { [ LLM::Chat::Conversation::Message.new(role => 'user', content => 'tool result follows') ] }

# ------------------------------------------------------------------

subtest 'stream: a stop sequence reported as length completes as stop' => {
	plan 12;
	$kobold.script('stopper', chat("\n", 'length'), usage(900, 3), '[DONE]');
	$kobold.perf('stopper', perf(stop-reason => 2, count => 3));
	my $resp = stream-settled(backend('stopper').chat-completion-stream(turn()), 'stopper');

	ok $resp.is-success, 'the generation completes';
	is $resp.finish-reason, 'stop', 'finish-reason is stop';
	is $resp.provider-finish-reason, 'length', 'the wire value is kept';
	is $resp.latest, "\n", 'with the text KoboldCpp sent';
	is $resp.completion-tokens, 3, 'and its usage';
	nok $resp.error-class.defined, 'no error class';
	is $kobold.perf-hits('stopper'), 1, 'perf was asked exactly once';

	my %e = $resp.finish-reason-evidence;
	is %e<source>, 'koboldcpp:/api/extra/perf', 'evidence names its source';
	is %e<verdict>, 'stop', 'evidence records the verdict';
	is %e<stop_reason>, 2, 'and stop_reason';
	is (%e<last_token_count>, %e<completion_tokens>), (3, 3), 'and the counts it matched';
	like %e<note>, /'custom stop sequence'/, 'and says why';
};

subtest 'stream: a real budget exhaustion stays length' => {
	plan 5;
	$kobold.script('budget', chat('long text', 'length'), usage(900, 64), '[DONE]');
	$kobold.perf('budget', perf(stop-reason => 0, count => 64));
	my $resp = stream-settled(backend('budget').chat-completion-stream(turn()), 'budget');

	nok $resp.is-success, 'a truncated generation is a failure';
	is $resp.err, 'Hit max tokens', 'Hit max tokens, as before';
	is $resp.completion-tokens, 64, 'now with its usage';
	is $resp.finish-reason-evidence<verdict>, 'length', 'evidence verdict length';
	like $resp.finish-reason-evidence<note>, /'stop_reason 0'/, 'because stop_reason was 0';
};

subtest 'stream: a count that does not match the usage stays length' => {
	plan 3;
	# stop_reason 2 — but for 9 tokens, and this stream produced 3:
	# perf is describing some other generation.
	$kobold.script('mismatch', chat('x', 'length'), usage(900, 3), '[DONE]');
	$kobold.perf('mismatch', perf(stop-reason => 2, count => 9));
	my $resp = stream-settled(backend('mismatch').chat-completion-stream(turn()), 'mismatch');

	nok $resp.is-success, 'still a failure';
	is $resp.finish-reason, 'length', 'finish-reason length';
	like $resp.finish-reason-evidence<note>, /'does not match'/, 'evidence says why';
};

subtest 'stream without usage (KoboldCpp\'s tool-call stream shape)' => {
	plan 7;
	# KoboldCpp fakes streaming when tools are present: content, a final
	# finish chunk, [DONE] — and no usage frame, even when asked.
	$kobold.script('no-usage', chat(''), chat('', 'length'), '[DONE]');
	$kobold.perf('no-usage', perf(stop-reason => 2, count => 3));
	my $resp = stream-settled(backend('no-usage').chat-completion-stream(turn()), 'no usage');

	ok $resp.is-success, 'a count well under max_tokens is believed';
	is $resp.finish-reason, 'stop', 'finish-reason stop';
	my %e = $resp.finish-reason-evidence;
	is %e<max_tokens>, 64, 'evidence carries the budget it compared against';
	nok %e<completion_tokens>:exists, 'and no usage count';

	$kobold.script('no-usage-near', chat('', 'length'), '[DONE]');
	$kobold.perf('no-usage-near', perf(stop-reason => 2, count => 60));
	my $near = stream-settled(backend('no-usage-near').chat-completion-stream(turn()), 'near budget');
	nok $near.is-success, 'a count near max_tokens is not';
	is $near.finish-reason, 'length', 'finish-reason stays length';
	like $near.finish-reason-evidence<note>, /'not well under'/, 'evidence says why';
};

subtest 'a perf check that fails leaves length' => {
	plan 8;
	for (
		'perf-500'     => ('http-500', /'perf request failed'/),
		'perf-text'    => ('not-json', /'perf request failed'/),
		'perf-array'   => ('array',    /'not a JSON object'/),
		'perf-partial' => (%( stop_reason => 2 ), /'no integer'/),
	) -> (:key($name), :value(($answer, $why))) {
		$kobold.script($name, chat('x', 'length'), usage(1, 1), '[DONE]');
		$kobold.perf($name, $answer);
		my $resp = stream-settled(backend($name).chat-completion-stream(turn()), $name);
		is $resp.err, 'Hit max tokens', "$name: stays a length failure";
		like $resp.finish-reason-evidence<note>, $why, "$name: evidence says why";
	}
};

subtest 'a perf check that hangs is bounded' => {
	plan 4;
	$kobold.script('perf-hang', chat('x', 'length'), usage(1, 1), '[DONE]');
	$kobold.perf('perf-hang', 'hang');
	my $t0 = now;
	my $resp = stream-settled(
		backend('perf-hang', verify-length-finish-timeout => 0.5).chat-completion-stream(turn()),
		'perf hang',
	);
	my $elapsed = now - $t0;
	ok $elapsed < 5, "settled in {$elapsed.round(0.01)}s, not the server's time";
	is $resp.err, 'Hit max tokens', 'length stands';
	is $resp.completion-tokens, 1, 'usage kept';
	like $resp.finish-reason-evidence<note>, /'did not answer within 0.5s'/, 'evidence says it timed out';
};

subtest 'verify-length-finish off: no check, length stands' => {
	plan 4;
	$kobold.script('off', chat("\n", 'length'), usage(1, 1), '[DONE]');
	$kobold.perf('off', perf(stop-reason => 2, count => 1));
	my $resp = stream-settled(
		backend('off', verify-length-finish => False).chat-completion-stream(turn()),
		'verify off',
	);
	nok $resp.is-success, 'length is a failure';
	is $resp.finish-reason, 'length', 'finish-reason length';
	is $kobold.perf-hits('off'), 0, 'perf was never asked';
	is-deeply $resp.finish-reason-evidence, %(), 'no evidence recorded';
};

subtest 'a stop finish is never checked' => {
	plan 3;
	$kobold.script('eos', chat('fine', 'stop'), usage(1, 1), '[DONE]');
	$kobold.perf('eos', perf(stop-reason => 1, count => 1));
	my $resp = stream-settled(backend('eos').chat-completion-stream(turn()), 'eos');
	ok $resp.is-success, 'success';
	is $kobold.perf-hits('eos'), 0, 'perf was never asked';
	is $resp.provider-finish-reason, 'stop', 'provider-finish-reason stop';
};

subtest 'text stream: a stop sequence reported as length completes as stop' => {
	plan 3;
	$kobold.script('text-stopper', text('The end.', 'length'), usage(50, 4), '[DONE]');
	$kobold.perf('text-stopper', perf(stop-reason => 2, count => 4));
	my $resp = stream-settled(backend('text-stopper').text-completion-stream(turn()), 'text stopper');
	ok $resp.is-success, 'success';
	is $resp.finish-reason, 'stop', 'finish-reason stop';
	is $resp.latest, 'The end.', 'reply intact';
};

subtest 'blocking paths: the finish reason is corrected, the usage matched' => {
	plan 6;
	$kobold.json('blocking-chat', {
		choices => [ { index => 0, message => { role => 'assistant', content => '' }, finish_reason => 'length' }, ],
		usage   => { prompt_tokens => 900, completion_tokens => 2, total_tokens => 902 },
	});
	$kobold.perf('blocking-chat', perf(stop-reason => 2, count => 2));
	my $chat = stream-settled(backend('blocking-chat').chat-completion(turn()), 'blocking chat');
	is $chat.finish-reason, 'stop', 'chat: finish-reason stop';
	is $chat.provider-finish-reason, 'length', 'chat: wire value kept';
	is $chat.finish-reason-evidence<completion_tokens>, 2, 'chat: matched against the body usage';

	$kobold.json('blocking-text', {
		choices => [ { index => 0, text => 'ok', finish_reason => 'length' }, ],
		usage   => { prompt_tokens => 10, completion_tokens => 5, total_tokens => 15 },
	});
	$kobold.perf('blocking-text', perf(stop-reason => 0, count => 5));
	my $text = stream-settled(backend('blocking-text').text-completion(turn()), 'blocking text');
	ok $text.is-success, 'text: blocking completions succeed as before';
	is $text.finish-reason, 'length', 'text: a genuine length stays length';
	is $kobold.perf-hits('blocking-text'), 1, 'text: after checking';
};

subtest 'the perf request goes to the server root, with the API key' => {
	plan 2;
	$kobold.script('where', chat('x', 'length'), usage(1, 1), '[DONE]');
	$kobold.perf('where', perf(stop-reason => 2, count => 1));
	stream-settled(backend('where', api_key => 'sekrit').chat-completion-stream(turn()), 'where');
	is $kobold.perf-path('where'), '/where/api/extra/perf', 'GET /api/extra/perf, not under /v1';
	is $kobold.perf-auth('where'), 'Bearer sekrit', 'carrying the same Authorization header';
};

subtest 'a cancel during the perf check stays a cancel' => {
	plan 4;
	$kobold.script('cancel-probe', chat('x', 'length'), usage(1, 1), '[DONE]');
	$kobold.perf('cancel-probe', 'hang');
	my $resp = backend('cancel-probe', verify-length-finish-timeout => 1).chat-completion-stream(turn());

	my $deadline = now + TIMEOUT;
	sleep 0.01 until $kobold.perf-hits('cancel-probe') || now > $deadline;
	ok $kobold.perf-hits('cancel-probe'), 'the check is in flight';
	$resp.cancel;
	ok $resp.is-cancelled, 'cancel takes effect at once';

	sleep 1.5;   # past the check's own timeout
	is $resp.err, 'Cancelled by user', 'the settle after the check does not overwrite it';
	nok $resp.error-class.defined, 'and does not classify it';
};

subtest 'evidence is a detached copy' => {
	plan 1;
	$kobold.script('copy', chat('x', 'length'), usage(1, 1), '[DONE]');
	$kobold.perf('copy', perf(stop-reason => 2, count => 1));
	my $resp = stream-settled(backend('copy').chat-completion-stream(turn()), 'copy');
	my %e = $resp.finish-reason-evidence;
	%e<verdict> = 'tampered';
	is $resp.finish-reason-evidence<verdict>, 'stop', 'mutating the returned Hash changes nothing';
};

subtest 'verify-length-finish-timeout validation' => {
	plan 4;
	dies-ok { backend('v', verify-length-finish-timeout => 0) }, 'zero dies';
	dies-ok { backend('v', verify-length-finish-timeout => Inf) }, 'Inf dies — the check must be bounded';
	dies-ok { backend('v', verify-length-finish-timeout => NaN) }, 'NaN dies';
	is backend('v').verify-length-finish-timeout, 2, 'default is two seconds';
};

done-testing;
