use Test;
use lib 'lib';
use JSON::Fast;
use LLM::Chat::Backend::Response;
use LLM::Chat::Backend::OpenAICommon;
use LLM::Chat::Backend::Settings;
use LLM::Chat::Conversation::Message;

plan 12;

# === Response tool call parsing ===

subtest 'Response: no tool calls by default' => {
	plan 2;
	my $resp = LLM::Chat::Backend::Response.new(id => 'r1');
	nok $resp.has-tool-calls, 'No tool calls initially';
	is $resp.tool-calls.elems, 0, 'Empty tool calls list';
};

subtest 'Response: tool calls set and retrieved' => {
	plan 3;
	my $resp = LLM::Chat::Backend::Response.new(id => 'r2');
	my @calls = (
		{
			id => 'call_123',
			type => 'function',
			function => {
				name => 'get_weather',
				arguments => '{"location": "London"}',
			},
		},
	);
	$resp._set-tool-calls(@calls);
	$resp._set-finish-reason('tool_calls');

	ok $resp.has-tool-calls, 'Has tool calls';
	is $resp.tool-calls[0]<function><name>, 'get_weather', 'Tool name extracted';
	is $resp.finish-reason, 'tool_calls', 'Finish reason set';
};

subtest 'Response: multiple tool calls' => {
	plan 2;
	my $resp = LLM::Chat::Backend::Response.new(id => 'r3');
	my @calls = (
		{ id => 'c1', type => 'function', function => { name => 'search', arguments => '{"q":"raku"}' } },
		{ id => 'c2', type => 'function', function => { name => 'fetch', arguments => '{"url":"http://example.com"}' } },
	);
	$resp._set-tool-calls(@calls);

	is $resp.tool-calls.elems, 2, 'Two tool calls';
	is $resp.tool-calls[1]<function><name>, 'fetch', 'Second tool name';
};

# === Tool definitions in OpenAI format ===

subtest 'Tool definition format' => {
	plan 3;
	my @tools = [
		{
			type => 'function',
			function => {
				name => 'get_weather',
				description => 'Get weather for a location',
				parameters => {
					type => 'object',
					properties => {
						location => { type => 'string', description => 'City name' },
					},
					required => ['location'],
				},
			},
		},
	];

	is @tools[0]<type>, 'function', 'Tool type';
	is @tools[0]<function><name>, 'get_weather', 'Function name';
	is @tools[0]<function><parameters><required>[0], 'location', 'Required param';
};

# === Simulated tool call flow ===

subtest 'Simulated tool call response parsing' => {
	plan 4;
	# Simulate what the OpenAI API returns as JSON (parsed via from-json like the real code)
	my $json = q:to/END/;
	{
		"choices": [{
			"finish_reason": "tool_calls",
			"message": {
				"role": "assistant",
				"content": null,
				"tool_calls": [
					{
						"id": "call_abc123",
						"type": "function",
						"function": {
							"name": "get_weather",
							"arguments": "{\"location\": \"London\"}"
						}
					}
				]
			}
		}]
	}
	END
	my $api-response = from-json($json);

	my $choice = $api-response<choices>[0];
	my $finish = $choice<finish_reason>;

	is $finish, 'tool_calls', 'Finish reason is tool_calls';
	ok $choice<message><tool_calls>.defined, 'Tool calls present';
	is $choice<message><tool_calls>[0]<function><name>, 'get_weather', 'Tool name';

	# Parse the arguments JSON
	my %args = from-json($choice<message><tool_calls>[0]<function><arguments>);
	is %args<location>, 'London', 'Tool arguments parsed';
};

subtest 'Tool result message format' => {
	plan 4;
	# After executing a tool, you send the result back as a tool message
	my $tool-result-msg = LLM::Chat::Conversation::Message.new(
		role => 'tool',
		content => '{"temperature": "15C", "conditions": "cloudy"}',
		tool-call-id => 'call_abc123',
	);
	is $tool-result-msg.role, 'tool', 'Tool message role';
	ok $tool-result-msg.content.contains('15C'), 'Tool result content';

	my %hash = $tool-result-msg.to-hash;
	is %hash<role>, 'tool', 'Tool role in hash';
	is %hash<tool_call_id>, 'call_abc123', 'Tool call ID in hash';
};

subtest 'Streaming tool call delta assembly' => {
	plan 5;

	my $resp = LLM::Chat::Backend::Response.new(id => 'stream-tools');
	$resp._append-tool-call-deltas([
		{
			index => 0,
			id => 'call_12981',
			type => 'function',
			function => {
				name => 'get_weather',
				arguments => '',
			},
		},
	]);
	$resp._append-tool-call-deltas([
		{
			index => 0,
			function => {
				arguments => '{"location":',
			},
		},
		{
			index => 0,
			function => {
				arguments => '"London"}',
			},
		},
	]);
	$resp._set-finish-reason('tool_calls');

	ok $resp.has-tool-calls, 'Streaming deltas create tool calls';
	is $resp.tool-calls.elems, 1, 'One tool call assembled';
	is $resp.tool-calls[0]<id>, 'call_12981', 'Tool call ID retained';
	is $resp.tool-calls[0]<function><name>, 'get_weather', 'Function name retained';
	is $resp.tool-calls[0]<function><arguments>, '{"location":"London"}',
		'Arguments fragments concatenated';
};

# === Streaming deltas that carry no `index` ===
#
# The OAI streaming spec puts an `index` on every tool_calls fragment,
# but providers omit it, and the fallback used to be "index = number of
# builders so far". That got the FIRST fragment of a call right and
# then sent every argument fragment after it to a brand-new builder: a
# single tool call arrived shattered into N calls, each holding an
# unparseable slice of the JSON. Downstream that is a tool invocation
# with truncated arguments — the failure mode that motivated all of
# this.
#
# What actually distinguishes the two cases is `id`. The spec sends it
# (with `type`, and the function `name`) only on a call's FIRST
# fragment; argument fragments carry nothing but function.arguments.

subtest 'index-less deltas: id starts a call, the rest continue it' => {
	plan 4;

	my $resp = LLM::Chat::Backend::Response.new(id => 'no-index-one');
	$resp._append-tool-call-deltas([
		{
			id => 'call_a1',
			type => 'function',
			function => { name => 'task', arguments => '' },
		},
	]);
	$resp._append-tool-call-deltas([
		{ function => { arguments => '{"prompt":"write' } },
	]);
	$resp._append-tool-call-deltas([
		{ function => { arguments => ' it in full"}' } },
	]);

	is $resp.tool-calls.elems, 1,
		'an id-bearing delta plus two continuations is ONE call';
	is $resp.tool-calls[0]<id>, 'call_a1', 'the id is retained';
	is $resp.tool-calls[0]<function><name>, 'task', 'the name is retained';
	is $resp.tool-calls[0]<function><arguments>, '{"prompt":"write it in full"}',
		'and the argument fragments concatenate into parseable JSON';
};

subtest 'index-less deltas: each id is a new call' => {
	plan 5;

	my $resp = LLM::Chat::Backend::Response.new(id => 'no-index-two');
	$resp._append-tool-call-deltas([
		{ id => 'call_b1', type => 'function',
		  function => { name => 'search', arguments => '{"q":"raku"}' } },
	]);
	$resp._append-tool-call-deltas([
		{ id => 'call_b2', type => 'function',
		  function => { name => 'fetch', arguments => '{"url":"x"}' } },
	]);

	is $resp.tool-calls.elems, 2, 'two id-bearing deltas make two calls';
	is $resp.tool-calls[0]<id>, 'call_b1', 'first call keeps its id';
	is $resp.tool-calls[1]<id>, 'call_b2', 'second call keeps its id';
	is $resp.tool-calls[0]<function><arguments>, '{"q":"raku"}',
		'first call keeps its own arguments';
	is $resp.tool-calls[1]<function><arguments>, '{"url":"x"}',
		'and the second call did not inherit them';
};

subtest 'index-less deltas: an id after an explicit index starts a call' => {
	plan 4;

	# The mixed case: a provider that indexes its opening fragment and
	# then stops. The id says "new call" whatever came before it, so it
	# lands one past the highest builder rather than appending to it.
	my $resp = LLM::Chat::Backend::Response.new(id => 'no-index-mixed');
	$resp._append-tool-call-deltas([
		{ index => 0, id => 'call_c1', type => 'function',
		  function => { name => 'first', arguments => '{"a":1}' } },
	]);
	$resp._append-tool-call-deltas([
		{ id => 'call_c2', type => 'function',
		  function => { name => 'second', arguments => '{"b":' } },
	]);
	$resp._append-tool-call-deltas([
		{ function => { arguments => '2}' } },
	]);

	is $resp.tool-calls.elems, 2, 'the id-bearing delta opened a second call';
	is $resp.tool-calls[0]<function><arguments>, '{"a":1}',
		'the indexed call is untouched';
	is $resp.tool-calls[1]<id>, 'call_c2', 'the new call keeps its id';
	is $resp.tool-calls[1]<function><arguments>, '{"b":2}',
		'and the index-less continuation went to it, not back to index 0';
};

subtest 'explicit indices still win, interleaved' => {
	plan 4;

	# The regression pin for the path that always worked: parallel calls
	# streamed interleaved, which is the ONLY thing `index` can express
	# and the reason it is authoritative when present.
	my $resp = LLM::Chat::Backend::Response.new(id => 'indexed');
	$resp._append-tool-call-deltas([
		{ index => 0, id => 'call_d1', type => 'function',
		  function => { name => 'alpha', arguments => '{"x":' } },
		{ index => 1, id => 'call_d2', type => 'function',
		  function => { name => 'beta', arguments => '{"y":' } },
	]);
	$resp._append-tool-call-deltas([
		{ index => 1, function => { arguments => '2}' } },
		{ index => 0, function => { arguments => '1}' } },
	]);

	is $resp.tool-calls.elems, 2, 'two interleaved calls stay two calls';
	is $resp.tool-calls[0]<function><name>, 'alpha',
		'calls come back in index order';
	is $resp.tool-calls[0]<function><arguments>, '{"x":1}',
		'index 0 assembled from its own fragments only';
	is $resp.tool-calls[1]<function><arguments>, '{"y":2}',
		'index 1 assembled from its own fragments only';
};

subtest 'an index-less continuation with no call open opens one' => {
	plan 2;

	# Degenerate, but a provider can lead with an arguments-only
	# fragment. There is nothing to continue, so it starts index 0
	# rather than being dropped or exploding on an empty builder set.
	my $resp = LLM::Chat::Backend::Response.new(id => 'no-index-cold');
	$resp._append-tool-call-deltas([
		{ function => { arguments => '{"orphan":true}' } },
	]);

	is $resp.tool-calls.elems, 1, 'a cold continuation still lands somewhere';
	is $resp.tool-calls[0]<function><arguments>, '{"orphan":true}',
		'with its arguments intact';
};

done-testing;
