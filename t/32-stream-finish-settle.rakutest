use Test;
use lib 'lib';

use LLM::Chat::Test::Kit;
use LLM::Chat::Backend::OpenAICommon;
use LLM::Chat::Backend::Response;
use LLM::Chat::Backend::Settings;
use LLM::Chat::Conversation::Message;
use LLM::Chat::Template::ChatML;

use JSON::Fast;

# A finish reason is recorded where it arrives and acted on where the
# stream settles.
#
# The OpenAI usage frame (stream_options.include_usage) comes AFTER the
# finish chunk: `finish_reason: "length"`, then `{"choices":[],
# "usage":{...}}`, then `[DONE]`. Both streaming paths used to quit the
# Response the moment they read a `length`, `content_filter` or unknown
# reason — and the text path settled on `stop` the same way — so the
# usage frame was never read and a failed (or, on the text path, any)
# stream reported no token counts at all. KoboldCpp reports every
# non-EOS stop as `length`, which made that "every KoboldCpp stream
# that ended on a stop sequence".
#
# Now: the finish chunk is the last one whose deltas count, later
# chunks are read for usage only, and the Response is settled by
# [DONE], the body closing, or — for a server that goes quiet after its
# finish chunk — the stream-finish-grace timer, which also drops the
# connection. Cancellation keeps working in the gap.
#
# The fixture is a real HTTP server whose SSE bodies follow a script:
# frames, pauses between them (so a quit-at-the-finish-chunk client
# would demonstrably miss the usage frame), and HOLD, which keeps the
# connection open with keep-alive comments until the client hangs up.
# It is LLM::Chat::Test::Kit's raw server, which sees a hang-up the
# moment the client closes the connection and closes the body's tap,
# which runs its CLOSE phaser.

plan 14;

# Script step: stop sending frames but keep the connection open.
constant HOLD = 'HOLD';

# Seconds allowed for a hang-up to reach the server's CLOSE phaser.
constant DISCONNECT-LIMIT = 10;

class ScriptServer {
	has      $.server;
	has Int  $.port;
	has      %!scripts;
	has      %!blocking;
	has      %!hangups;
	has Lock $!lock .= new;

	method script(Str:D $name, *@steps --> ScriptServer) {
		$!lock.protect: {
			%!scripts{$name} = @steps.List;
			%!hangups{$name} = Promise.new;
		};
		self;
	}

	method json(Str:D $name, %body --> ScriptServer) {
		$!lock.protect: { %!blocking{$name} = to-json(%body, :!pretty) };
		self;
	}

    #| Kept when the client hangs up on a HOLD stream.
	method hung-up(Str:D $name --> Promise) {
		$!lock.protect: { %!hangups{$name} }
	}

	method !sse(Str:D $name --> Supply) {
		my ($steps, $hangup) = $!lock.protect: { (%!scripts{$name}, %!hangups{$name}) };
		supply {
			my $out = Supplier::Preserving.new;
			whenever $out.Supply -> $bytes { emit $bytes }
			CLOSE { $hangup.keep(True) unless $hangup.status }
			start {
				my Bool $hold = False;
				for $steps.list -> $step {
					if $step ~~ Numeric { sleep $step }
					elsif $step eq HOLD { $hold = True; last }
					else { $out.emit("data: $step\n\n".encode('utf-8')) }
				}
				if $hold {
					my $deadline = now + 60;
					until $hangup.status || now > $deadline {
						$out.emit(": keep-alive\n\n".encode('utf-8'));
						sleep 0.05;
					}
				}
				$out.done;
			}
		}
	}

	method !json-for(Str:D $name --> Blob:D) {
		($!lock.protect: { %!blocking{$name} } // '{}').encode('utf-8');
	}

	method start(--> ScriptServer) {
		$!server = raw-server(-> $request {
			with $request.path ~~ / ^ '/' (<-[/]>+) '/v1/' [ 'chat/' ]? 'completions' $ / -> $route {
				my $name = ~$route[0];
				$request.json<stream>
					?? %( type => 'text/event-stream', chunks => self!sse($name) )
					!! %( body => self!json-for($name) );
			}
			else {
				%( status => 404, body => '' );
			}
		});
		$!port = $!server.port;
		self;
	}

	method stop(--> Nil) {
		$!server.stop with $!server;
		Nil;
	}
}

sub chat(Str:D $content, $reason = Nil --> Str:D) {
	to-json({ choices => [ { delta => { content => $content }, finish_reason => $reason }, ] }, :!pretty);
}

sub text(Str:D $text, $reason = Nil --> Str:D) {
	to-json({ choices => [ { text => $text, finish_reason => $reason }, ] }, :!pretty);
}

sub usage(Int:D $prompt, Int:D $completion --> Str:D) {
	to-json({
		model   => 'fixture/model',
		choices => [],
		usage   => {
			prompt_tokens     => $prompt,
			completion_tokens => $completion,
			total_tokens      => $prompt + $completion,
		},
	}, :!pretty);
}

# Records every call of the reconcile hook, and finishes a `length` as
# `stop`, the way a backend that knows its provider mislabels stop
# sequences would.
class RelabelBackend is LLM::Chat::Backend::OpenAICommon {
	has @.calls;
	has Lock $!calls-lock .= new;

	method _reconcile-finish-reason(
		LLM::Chat::Backend::Response $response,
		Str:D $reason,
		%request,
		--> Str:D
	) {
		$!calls-lock.protect: {
			@!calls.push: %(
				reason     => $reason,
				completion => $response.completion-tokens,
				max        => %request<max_tokens>,
			);
		};
		$reason eq 'length' ?? 'stop' !! $reason;
	}

	method call-count(--> Int:D) { $!calls-lock.protect: { @!calls.elems } }
}

class ThrowingBackend is LLM::Chat::Backend::OpenAICommon {
	method _reconcile-finish-reason(
		LLM::Chat::Backend::Response $response,
		Str:D $reason,
		%request,
		--> Str:D
	) {
		die 'probe exploded';
	}
}

my $server = ScriptServer.new.start;
LEAVE { $server.stop }

sub backend(Str:D $name, :$class = LLM::Chat::Backend::OpenAICommon, *%extra) {
	$class.new(
		api_url              => "http://127.0.0.1:{$server.port}/$name/v1",
		settings             => LLM::Chat::Backend::Settings.new(max_tokens => 64),
		template             => LLM::Chat::Template::ChatML.new,
		request-stream-usage => True,
		|%extra,
	);
}

sub turn() { [ LLM::Chat::Conversation::Message.new(role => 'user', content => 'hi'), ] }

sub hung-up-in-time(Str:D $name --> Bool:D) {
	my $p = $server.hung-up($name);
	await Promise.anyof($p, Promise.in(DISCONNECT-LIMIT));
	$p.status ~~ Kept;
}

# ------------------------------------------------------------------

subtest 'chat: a length finish still reads the usage frame after it' => {
	plan 9;
	$server.script('chat-length',
		chat('Once upon'), chat(' a time', 'length'), 0.3, usage(12, 34), '[DONE]');
	my $resp = stream-settled(backend('chat-length').chat-completion-stream(turn()), 'chat length');

	ok $resp.is-done, 'settled';
	nok $resp.is-success, 'a truncated generation is still a failure';
	is $resp.error-class, 'response', 'classified as a response error';
	is $resp.err, 'Hit max tokens', 'with the same error as before';
	is $resp.finish-reason, 'length', 'finish-reason length';
	is $resp.provider-finish-reason, 'length', 'and the provider said so';
	is $resp.prompt-tokens, 12, 'prompt tokens lifted from the frame after the finish chunk';
	is $resp.completion-tokens, 34, 'completion tokens too — they used to be lost';
	is $resp.latest, 'Once upon a time', 'the partial text is kept';
};

subtest 'text: a length finish still reads the usage frame after it' => {
	plan 5;
	$server.script('text-length',
		text('Once upon'), text(' a time', 'length'), 0.3, usage(21, 43), '[DONE]');
	my $resp = stream-settled(backend('text-length').text-completion-stream(turn()), 'text length');

	nok $resp.is-success, 'a failure';
	is $resp.err, 'Hit max tokens', 'with the same error as before';
	is $resp.finish-reason, 'length', 'finish-reason length';
	is $resp.completion-tokens, 43, 'usage lifted';
	is $resp.latest, 'Once upon a time', 'the partial text is kept';
};

subtest 'content_filter and unknown reasons keep their errors and gain usage' => {
	plan 6;
	$server.script('chat-filter', chat('nope', 'content_filter'), 0.2, usage(3, 4), '[DONE]');
	$server.script('chat-unknown', chat('huh', 'error'), 0.2, usage(5, 6), '[DONE]');

	my $filtered = stream-settled(backend('chat-filter').chat-completion-stream(turn()), 'filter');
	nok $filtered.is-success, 'content_filter fails';
	is $filtered.err, 'Blocked by content filter', 'with its error';
	is $filtered.completion-tokens, 4, 'and its usage';

	my $unknown = stream-settled(backend('chat-unknown').chat-completion-stream(turn()), 'unknown');
	nok $unknown.is-success, 'an unknown reason fails';
	is $unknown.err, 'Unknown finish reason: error', 'naming the reason';
	is $unknown.completion-tokens, 6, 'and its usage';
};

subtest 'stop finishes keep the usage frame on both paths' => {
	plan 6;
	# The text path used to settle the moment it read `stop`, so a
	# successful text stream never reported usage either.
	$server.script('text-stop', text('Once upon'), text(' a time', 'stop'), 0.3, usage(7, 8), '[DONE]');
	$server.script('chat-stop', chat('Once upon'), chat(' a time', 'stop'), 0.3, usage(9, 10), '[DONE]');

	my $text = stream-settled(backend('text-stop').text-completion-stream(turn()), 'text stop');
	ok $text.is-success, 'text: success';
	is $text.completion-tokens, 8, 'text: usage lifted';
	is $text.latest, 'Once upon a time', 'text: whole reply';

	my $chat = stream-settled(backend('chat-stop').chat-completion-stream(turn()), 'chat stop');
	ok $chat.is-success, 'chat: success';
	is $chat.completion-tokens, 10, 'chat: usage lifted';
	is $chat.provider-finish-reason, 'stop', 'chat: provider-finish-reason matches';
};

subtest '[DONE] after a failure reason does not turn it into a success' => {
	plan 4;
	$server.script('chat-length-done', chat('cut', 'length'), '[DONE]');
	my $resp = stream-settled(backend('chat-length-done').chat-completion-stream(turn()), 'length + done');
	nok $resp.is-success, '[DONE] only means the server stopped talking';
	is $resp.err, 'Hit max tokens', 'the failure is the finish reason\'s';
	nok $resp.completion-tokens.defined, 'no usage was sent, none is invented';
	is $resp.latest, 'cut', 'partial text kept';
};

subtest 'a failure reason then a close without [DONE]' => {
	plan 6;
	$server.script('chat-length-close', chat('cut', 'length'), 0.2, usage(1, 2));
	$server.script('text-length-close', text('cut', 'length'), 0.2, usage(3, 4));

	my $chat = stream-settled(backend('chat-length-close').chat-completion-stream(turn()), 'chat close');
	nok $chat.is-success, 'chat: failure';
	is $chat.err, 'Hit max tokens', 'chat: the finish reason\'s error, not "closed without [DONE]"';
	is $chat.completion-tokens, 2, 'chat: usage read before the close';

	my $text = stream-settled(backend('text-length-close').text-completion-stream(turn()), 'text close');
	nok $text.is-success, 'text: failure';
	is $text.err, 'Hit max tokens', 'text: the finish reason\'s error';
	is $text.completion-tokens, 4, 'text: usage read before the close';
};

subtest 'deltas after the finish chunk are not emitted' => {
	plan 6;
	my $late-tool = to-json({ choices => [ { delta => { tool_calls => [
		{ index => 0, id => 'call_late', type => 'function', function => { name => 'x', arguments => '{}' } },
	] }, finish_reason => Nil }, ] }, :!pretty);
	$server.script('chat-late', chat('kept', 'length'), chat('LEAKED'), $late-tool, usage(1, 1), '[DONE]');
	$server.script('text-late', text('kept', 'stop'), text('LEAKED'), '[DONE]');

	my $chat = stream-settled(backend('chat-late').chat-completion-stream(turn()), 'chat late');
	is $chat.latest, 'kept', 'chat: content after the finish chunk is dropped';
	nok $chat.has-tool-calls, 'chat: so are tool-call deltas';
	is $chat.completion-tokens, 1, 'chat: usage is still read';
	is $chat.err, 'Hit max tokens', 'chat: the first finish reason decides';

	my $text = stream-settled(backend('text-late').text-completion-stream(turn()), 'text late');
	ok $text.is-success, 'text: success';
	is $text.latest, 'kept', 'text: text after the finish chunk is dropped';
};

subtest 'a server that goes quiet after its finish chunk' => {
	plan 11;
	$server.script('chat-quiet-length', chat('cut', 'length'), usage(5, 5), HOLD);
	$server.script('chat-quiet-stop', chat('whole', 'stop'), HOLD);
	$server.script('text-quiet-stop', text('whole', 'stop'), usage(2, 3), HOLD);

	my $t0 = now;
	my $length = stream-settled(
		backend('chat-quiet-length', stream-finish-grace => 0.5).chat-completion-stream(turn()),
		'quiet length',
	);
	my $elapsed = now - $t0;
	ok $elapsed >= 0.4, "not settled before the grace ran out ({$elapsed.round(0.01)}s)";
	ok $elapsed < 5, 'and settled soon after it';
	is $length.err, 'Hit max tokens', 'settled on the reason it gave';
	is $length.completion-tokens, 5, 'with the usage it sent';
	ok hung-up-in-time('chat-quiet-length'), 'and the connection was dropped';

	my $stop = stream-settled(
		backend('chat-quiet-stop', stream-finish-grace => 0.5).chat-completion-stream(turn()),
		'quiet stop',
	);
	ok $stop.is-success, 'a quiet stream that said stop is a success';
	is $stop.latest, 'whole', 'with its reply';
	ok hung-up-in-time('chat-quiet-stop'), 'and its connection dropped';

	my $text = stream-settled(
		backend('text-quiet-stop', stream-finish-grace => 0.5).text-completion-stream(turn()),
		'quiet text',
	);
	ok $text.is-success, 'text: success';
	is $text.completion-tokens, 3, 'text: usage kept';
	ok hung-up-in-time('text-quiet-stop'), 'text: connection dropped';
};

subtest 'cancel between the finish chunk and the usage frame' => {
	plan 7;
	$server.script('chat-cancel-gap', chat('partial', 'length'), HOLD);
	my $backend = backend('chat-cancel-gap', class => RelabelBackend);
	my $resp = $backend.chat-completion-stream(turn());

	my $deadline = now + TIMEOUT;
	sleep 0.01 until $resp.finish-reason.defined || now > $deadline;
	ok $resp.finish-reason.defined, 'the finish chunk arrived';
	nok $resp.is-done, 'and the stream is waiting for what follows it';

	$resp.cancel;
	ok $resp.is-cancelled, 'cancel takes effect';
	is $resp.err, 'Cancelled by user', 'as a cancel';
	nok $resp.error-class.defined, 'not classified as a failure';
	ok hung-up-in-time('chat-cancel-gap'), 'the connection is dropped';
	is $backend.call-count, 0, 'and a cancelled stream is never reconciled';
};

subtest 'the reconcile hook runs once, at the settle point, with usage in hand' => {
	plan 8;
	$server.script('chat-relabel', chat('ends on a stop string', 'length'), 0.2, usage(40, 7), '[DONE]');
	my $backend = backend('chat-relabel', class => RelabelBackend);
	my $resp = stream-settled($backend.chat-completion-stream(turn()), 'relabel');

	ok $resp.is-success, 'a length relabelled stop completes the stream';
	is $resp.finish-reason, 'stop', 'finish-reason is the decided one';
	is $resp.provider-finish-reason, 'length', 'provider-finish-reason keeps the wire value';
	is $resp.latest, 'ends on a stop string', 'the reply is intact';
	is $backend.call-count, 1, 'the hook ran once';
	is $backend.calls[0]<completion>, 7, 'after the usage frame had been read';
	is $backend.calls[0]<max>, 64, 'with the posted request body';

	$server.script('chat-no-reason', chat('plain'), '[DONE]');
	my $quiet = backend('chat-no-reason', class => RelabelBackend);
	stream-settled($quiet.chat-completion-stream(turn()), 'no reason');
	is $quiet.call-count, 0, 'a stream with no finish reason is not reconciled';
};

subtest 'the reconcile hook on the blocking paths' => {
	plan 7;
	$server.json('blocking-chat', {
		choices => [ { message => { content => 'done.' }, finish_reason => 'length' }, ],
		usage   => { prompt_tokens => 10, completion_tokens => 2, total_tokens => 12 },
	});
	$server.json('blocking-text', {
		choices => [ { text => 'done.', finish_reason => 'length' }, ],
		usage   => { prompt_tokens => 11, completion_tokens => 3, total_tokens => 14 },
	});

	my $backend = backend('blocking-chat', class => RelabelBackend);
	my $chat = stream-settled($backend.chat-completion(turn()), 'blocking chat');
	is $chat.finish-reason, 'stop', 'chat: decided reason';
	is $chat.provider-finish-reason, 'length', 'chat: wire reason kept';
	is $backend.calls[0]<completion>, 2, 'chat: the hook saw the usage';

	my $text-backend = backend('blocking-text', class => RelabelBackend);
	my $text = stream-settled($text-backend.text-completion(turn()), 'blocking text');
	ok $text.is-success, 'text: success';
	is $text.finish-reason, 'stop', 'text: decided reason';
	is $text.provider-finish-reason, 'length', 'text: wire reason kept';
	is $text.msg, 'done.', 'text: reply intact';
};

subtest 'blocking text completions now report usage and the finish reason' => {
	plan 5;
	$server.json('blocking-text-plain', {
		choices => [ { text => 'truncated', finish_reason => 'length' }, ],
		usage   => { prompt_tokens => 5, completion_tokens => 64, total_tokens => 69 },
		model   => 'fixture/model',
	});
	my $resp = stream-settled(backend('blocking-text-plain').text-completion(turn()), 'plain text');
	ok $resp.is-success, 'the blocking contract is unchanged: the body arrived';
	is $resp.finish-reason, 'length', 'finish-reason recorded';
	is $resp.completion-tokens, 64, 'completion tokens lifted';
	is $resp.prompt-tokens, 5, 'prompt tokens lifted';
	is $resp.model-used, 'fixture/model', 'model lifted';
};

subtest 'a hook that throws leaves the provider reason in force' => {
	plan 3;
	$server.script('chat-throwing', chat('cut', 'length'), usage(1, 1), '[DONE]');
	my $resp = stream-settled(
		backend('chat-throwing', class => ThrowingBackend).chat-completion-stream(turn()),
		'throwing hook',
	);
	nok $resp.is-success, 'still a failure';
	is $resp.err, 'Hit max tokens', 'for the provider\'s reason';
	is $resp.finish-reason, 'length', 'finish-reason untouched';
};

subtest 'stream-finish-grace validation' => {
	plan 5;
	dies-ok { backend('x', stream-finish-grace => 0) }, 'zero dies';
	dies-ok { backend('x', stream-finish-grace => -1) }, 'negative dies';
	dies-ok { backend('x', stream-finish-grace => NaN) }, 'NaN dies';
	lives-ok { backend('x', stream-finish-grace => Inf) }, 'Inf waits for the body';
	is backend('x').stream-finish-grace, 10, 'default is ten seconds';
};

done-testing;
