use Test;
use lib 'lib';

use LLM::Chat::Backend::KoboldCpp;
use LLM::Chat::Backend::Settings;
use LLM::Chat::Conversation::Message;
use LLM::Chat::Template::ChatML;

# A `data:` line that does not parse, and what it costs.
#
# Streaming backends skip malformed frames rather than failing the
# generation, and that is right: providers interleave error fragments,
# truncated frames and assorted junk into streams that are otherwise
# perfectly healthy, and killing the call over one of them throws away a
# reply that was fine. But skipping silently is only harmless for one
# kind of payload:
#
#   * PROSE. A few words go missing from the middle. The reply is
#     visibly odd to whoever reads it, and nothing downstream acts on it
#     as though it were structured.
#   * TOOL-CALL ARGUMENTS. They are streamed as JSON fragments that are
#     concatenated blind. A hole produces either a parse failure or —
#     the case that motivated this — a shorter string that is still
#     VALID JSON, saying something the model never asked for. Nothing
#     downstream can tell. That is silent corruption of an executable
#     instruction.
#
# So the skip is counted (Response.dropped-frames), and the count
# decides how the stream may end: a stream that dropped frames while
# assembling tool calls never reaches is-success, whatever else it did,
# including a perfectly well-formed [DONE].

plan 7;

# Canned SSE endpoint — see t/24-stream-close for the same fixture.
class SSEServer {
    has $.tap;
    has $.port;
    has @.conns;
    has Lock $!lock = Lock.new;

    method start(*@events) {
        my @body = @events;
        $!tap = IO::Socket::Async.listen('127.0.0.1', 0).tap(-> $conn {
            $!lock.protect: { @!conns.push($conn) };
            my Str $seen    = '';
            my Bool $served = False;
            $conn.Supply(:bin).tap(-> $bytes {
                $seen ~= $bytes.decode('latin-1');
                if !$served && $seen.contains("\r\n\r\n") {
                    $served = True;
                    $conn.print(
                        "HTTP/1.1 200 OK\r\n"
                        ~ "Content-Type: text/event-stream\r\n"
                        ~ "Cache-Control: no-cache\r\n"
                        ~ "Transfer-Encoding: chunked\r\n\r\n"
                    );
                    for @body -> $event {
                        # An event starting with ':' is written raw, so
                        # tests can put a real SSE comment (an
                        # OpenRouter-style heartbeat) on the wire.
                        my $frame = $event.starts-with(':')
                            ?? "$event\n\n"
                            !! "data: $event\n\n";
                        $conn.print(
                            $frame.encode('utf-8').bytes.base(16).lc
                            ~ "\r\n" ~ $frame ~ "\r\n"
                        );
                    }
                    $conn.print("0\r\n\r\n");
                }
            });
        });
        $!port = await $!tap.socket-port;
        self;
    }

    method stop() {
        .close for @!conns;
        $!tap.close;
    }
}

sub make-backend(Int $port) {
    LLM::Chat::Backend::KoboldCpp.new(
        api_url  => "http://127.0.0.1:$port/v1",
        settings => LLM::Chat::Backend::Settings.new(max_tokens => 64),
        template => LLM::Chat::Template::ChatML.new,
    );
}

sub user-turn() {
    [LLM::Chat::Conversation::Message.new(role => 'user', content => 'hi'),]
}

sub settles($response --> Bool) {
    my $deadline = now + 5;
    until $response.is-done {
        return False if now > $deadline;
        sleep 0.005;
    }
    True;
}

# A frame cut off mid-object: what a provider emits when its own
# upstream drops a buffer. It is a well-formed SSE event carrying
# malformed JSON, so it reaches the parser and throws there.
constant TRUNCATED =
    '{"choices":[{"delta":{"tool_calls":[{"index":0,"function":{"argumen';

my @tool-hole =
    '{"choices":[{"delta":{"tool_calls":[{"index":0,"id":"call_h1","type":"function","function":{"name":"task","arguments":""}}]},"finish_reason":null}]}',
    '{"choices":[{"delta":{"tool_calls":[{"index":0,"function":{"arguments":"{\"prompt\":\"write the"}}]},"finish_reason":null}]}',
    TRUNCATED,
    '{"choices":[{"delta":{"tool_calls":[{"index":0,"function":{"arguments":"\"}"}}]},"finish_reason":null}]}',
    '{"choices":[{"delta":{},"finish_reason":"tool_calls"}]}',
    '[DONE]';

my @prose-hole =
    '{"choices":[{"delta":{"content":"Once upon"},"finish_reason":null}]}',
    TRUNCATED,
    '{"choices":[{"delta":{"content":" a time"},"finish_reason":"stop"}]}',
    '[DONE]';

my @prose-clean =
    '{"choices":[{"delta":{"content":"Once upon"},"finish_reason":null}]}',
    '{"choices":[{"delta":{"content":" a time"},"finish_reason":"stop"}]}',
    '[DONE]';

my @text-hole =
    '{"choices":[{"text":"Once upon","finish_reason":null}]}',
    TRUNCATED,
    '{"choices":[{"text":" a time","finish_reason":"stop"}]}',
    '[DONE]';

subtest 'a hole while assembling tool calls fails the stream' => {
    plan 6;
    my $server = SSEServer.new.start(@tool-hole);
    LEAVE { $server.stop }

    my $resp = make-backend($server.port).chat-completion-stream(
        user-turn(),
        tools => [{ type => 'function', function => { name => 'task' } },],
    );

    ok settles($resp), 'the stream settles';
    is $resp.dropped-frames, 1, 'the dropped frame is counted';
    nok $resp.is-success,
        'and tool-call arguments with a hole in them are NOT a success — '
            ~ 'even though [DONE] arrived and the finish reason was tool_calls';
    is $resp.error-class, 'response', 'it classifies as a response error';
    ok ($resp.err // '').Str.contains('tool calls'),
        'the error names what the hole was in';
    is $resp.tool-calls[0]<function><arguments>, '{"prompt":"write the"}',
        'the assembled arguments are exposed for diagnosis — note that '
            ~ 'they parse as valid JSON while being nothing the model said';
};

subtest 'a hole in prose keeps the generation' => {
    plan 5;
    my $server = SSEServer.new.start(@prose-hole);
    LEAVE { $server.stop }

    my $resp = make-backend($server.port).chat-completion-stream(user-turn());

    ok settles($resp), 'the stream settles';
    is $resp.dropped-frames, 1, 'the dropped frame is counted';
    ok $resp.is-success,
        'prose with a gap in it is still a usable reply';
    is $resp.latest, 'Once upon a time',
        'everything that did parse is kept';
    nok $resp.error-class.defined, 'and no error class is set';
};

subtest 'a clean stream drops nothing' => {
    plan 3;
    my $server = SSEServer.new.start(@prose-clean);
    LEAVE { $server.stop }

    my $resp = make-backend($server.port).chat-completion-stream(user-turn());

    ok settles($resp), 'the stream settles';
    is $resp.dropped-frames, 0, 'the counter stays at zero';
    ok $resp.is-success, 'and the stream succeeds';
};

subtest 'text-completion-stream counts holes too' => {
    plan 4;
    my $server = SSEServer.new.start(@text-hole);
    LEAVE { $server.stop }

    my $resp = make-backend($server.port).text-completion-stream(user-turn());

    ok settles($resp), 'the stream settles';
    is $resp.dropped-frames, 1, 'the dropped frame is counted';
    ok $resp.is-success, 'a text completion with a gap is still a reply';
    is $resp.latest, 'Once upon a time', 'and keeps what parsed';
};

subtest 'every dropped frame is counted' => {
    plan 3;
    my $server = SSEServer.new.start(
        '{"choices":[{"delta":{"content":"a"},"finish_reason":null}]}',
        TRUNCATED,
        'not json at all',
        '{"choices":[{"delta":{"content":"b"},"finish_reason":null}]}',
        '{"broken":',
        '{"choices":[{"delta":{},"finish_reason":"stop"}]}',
        '[DONE]',
    );
    LEAVE { $server.stop }

    my $resp = make-backend($server.port).chat-completion-stream(user-turn());

    ok settles($resp), 'the stream settles';
    is $resp.dropped-frames, 3, 'all three unparseable frames are counted';
    is $resp.latest, 'ab', 'and the frames that parsed are all there';
};

subtest 'a hole plus a close with no [DONE] still names the hole' => {
    plan 4;
    # Both failure conditions at once. The dropped-frames rule is
    # checked first, because it is the more specific diagnosis: the
    # stream did say it was finished, it just cannot be trusted.
    my $server = SSEServer.new.start(@tool-hole[0..4]);
    LEAVE { $server.stop }

    my $resp = make-backend($server.port).chat-completion-stream(
        user-turn(),
        tools => [{ type => 'function', function => { name => 'task' } },],
    );

    ok settles($resp), 'the stream settles';
    nok $resp.is-success, 'it fails';
    is $resp.error-class, 'response', 'as a response error';
    ok ($resp.err // '').Str.contains('tool calls'),
        'named as the hole it is, not as a missing [DONE]';
};

subtest 'heartbeats and empty data lines are not dropped frames' => {
    plan 4;
    # Neither of these carries data, and neither is a hole in anything.
    # Counting them would be a false positive on the one counter that
    # can now FAIL a tool-call stream — against an OpenRouter-style
    # provider, every long generation would report frame loss.
    my $server = SSEServer.new.start(
        ': OPENROUTER PROCESSING',
        '{"choices":[{"delta":{"tool_calls":[{"index":0,"id":"call_k1","type":"function","function":{"name":"task","arguments":"{\"prompt\":\"go\"}"}}]},"finish_reason":null}]}',
        '',
        ': OPENROUTER PROCESSING',
        '{"choices":[{"delta":{},"finish_reason":"tool_calls"}]}',
        '[DONE]',
    );
    LEAVE { $server.stop }

    my $resp = make-backend($server.port).chat-completion-stream(
        user-turn(),
        tools => [{ type => 'function', function => { name => 'task' } },],
    );

    ok settles($resp), 'the stream settles';
    is $resp.dropped-frames, 0,
        'a heartbeat and an empty data line are not frame loss';
    ok $resp.is-success, 'so the tool-call stream still succeeds';
    is $resp.tool-calls[0]<function><arguments>, '{"prompt":"go"}',
        'with its arguments whole';
};

done-testing;
