use Test;
use lib 'lib';

use LLM::Chat::Backend::KoboldCpp;
use LLM::Chat::Backend::OpenAICommon;
use LLM::Chat::Backend::Response;
use LLM::Chat::Backend::Settings;
use LLM::Chat::Conversation::Message;
use LLM::Chat::Template::ChatML;
use LLM::Chat::Test::Kit;

# Does cancelling a generation actually STOP it?
#
# It used to not. `cancel` quit the local Supplier and nothing else: the
# consumer stopped seeing tokens while the backend's react loop went on
# draining the body to the very end, so an OpenAI-compatible server —
# llama.cpp's, OpenRouter, any of them — generated the entire reply for
# a request that had been abandoned, and billed for it. With a consumer
# that cancels freely (a chat UI where every re-roll supersedes the last
# request) that accumulates zombie generations on a slow model.
#
# The only honest way to test this is from the SERVER's side, because
# every client-side observation the old code could have passed. So the
# fixture is a real HTTP server (LLM::Chat::Test::Kit's raw server)
# streaming an endless SSE completion, and the assertion is that the
# server's response supply is torn down — its CLOSE phaser fires,
# because the client hung up — and that it produces no further tokens
# afterwards.
#
# FAIL-WITHOUT: empty out OpenAICommon's `!attach-aborter` so no
# transport handle is ever registered — the pre-fix behaviour exactly —
# and five subtests fail on the disconnect wait. The pre-headers one is
# the clearest: the fixture emitted 850 further frames after the cancel
# before the test gave up, into a socket nobody was reading. Meanwhile
# every client-side assertion in those same subtests still passed:
# .is-done, .is-cancelled, .err, .error-class. That is why the
# assertions that matter here are all server-side.
#
# The raw server notices a hang-up the moment the client closes its end
# of the connection, and closes the tap on the response's body supply,
# which is what runs that supply's CLOSE phaser.

plan 8;

# How long a disconnect may take to be noticed server-side before we
# call it "never happened". The fixture writes every EMIT-INTERVAL, so
# on loopback the failed write lands within a few milliseconds; this is
# three orders of magnitude of headroom for a loaded box.
constant DISCONNECT-LIMIT = 10;

# Cadence of the endless generation. Fast enough that a stream is
# flowing almost immediately, slow enough that a few hundred emissions
# over a whole test file stay cheap.
constant EMIT-INTERVAL = 0.01;

#| A fixture server that streams forever and remembers being hung up on.
#|
#| C<disconnected> is kept from the CLOSE phaser of the response body
#| supply, which the raw server runs when the connection carrying it
#| goes away — the server-side observation the whole file is about.
#| C<emitted> counts frames actually pushed, so a test can prove
#| generation STOPPED rather than merely that a close was noticed.
class EndlessServer {
	has          $.server;
	has Int      $.port;
	has Promise  $.disconnected .= new;
	has Int      $!emitted = 0;
	has Lock     $!lock .= new;
	has Numeric  $.header-delay = 0;
	has Int      $.abort-posts = 0;

	method emitted(--> Int) { $!lock.protect: { $!emitted } }

	method !bump(--> Int) { $!lock.protect: { ++$!emitted } }

	method !note-disconnect(--> Nil) {
		$!disconnected.keep(True) unless $!disconnected.status;
		Nil;
	}

    #| An SSE body that never ends. `$!shape` picks the frame the
    #| streaming path under test expects: chat deltas or text choices.
	method !endless-sse(Str:D $shape --> Supply) {
		supply {
			whenever Supply.interval(EMIT-INTERVAL) {
				my $n = self!bump;
				my $frame = $shape eq 'chat'
					?? '{"choices":[{"delta":{"content":"tok' ~ $n ~ ' "},"finish_reason":null}]}'
					!! '{"choices":[{"text":"tok' ~ $n ~ ' ","finish_reason":null}]}';
				emit "data: $frame\n\n".encode('utf-8');
			}
			CLOSE { self!note-disconnect }
		}
	}

    #| A non-streaming JSON body that never finishes arriving: correct
    #| Content-Type, plausible opening bytes, and then nothing but
    #| whitespace forever. The blocking path sits in `await
    #| $res.body-blob` on it, which is where a mid-body cancel has to
    #| bite.
	method !endless-json(--> Supply) {
		supply {
			emit '{"choices":[{"message":{"content":"'.encode('utf-8');
			whenever Supply.interval(EMIT-INTERVAL) {
				self!bump;
				emit 'tok '.encode('utf-8');
			}
			CLOSE { self!note-disconnect }
		}
	}

	method start(--> EndlessServer) {
		$!server = raw-server(-> $request {
			given $request.method, $request.path {
				# KoboldCpp's out-of-band abort, so the one backend with a
				# real abort endpoint can be shown to still use it.
				when ('POST', '/api/extra/abort') {
					self!count-abort;
					%( body => '{"success":true}' );
				}
				when ('POST', '/v1/chat/completions') {
					%( delay => $!header-delay, type => 'text/event-stream',
						chunks => self!endless-sse('chat') );
				}
				when ('POST', '/v1/completions') {
					%( delay => $!header-delay, type => 'text/event-stream',
						chunks => self!endless-sse('text') );
				}
				# Blocking (non-streaming) shape, on its own path so a test
				# can pick it deliberately.
				when ('POST', '/blocking/v1/chat/completions') {
					%( chunks => self!endless-json );
				}
				default {
					%( status => 404, body => '' );
				}
			}
		});
		$!port = $!server.port;
		self;
	}

	method !count-abort(--> Nil) {
		$!lock.protect: { $!abort-posts++ };
		Nil;
	}

	method abort-count(--> Int) { $!lock.protect: { $!abort-posts } }

	method stop(--> Nil) {
		$!server.stop with $!server;
		Nil;
	}
}

#| A fixture that answers with a short, well-formed SSE completion and
#| ends it properly. Needed by the "cancel after success" contract: the
#| endless server can never produce a naturally completed Response.
class FinishingServer {
	has     $.server;
	has Int $.port;

	method start(--> FinishingServer) {
		my @frames =
			'{"choices":[{"delta":{"content":"Once upon"},"finish_reason":null}]}',
			'{"choices":[{"delta":{"content":" a time"},"finish_reason":"stop"}]}',
			'[DONE]';

		$!server = raw-server(-> $request {
			$request.method eq 'POST' && $request.path eq '/v1/chat/completions'
				?? %( type => 'text/event-stream', chunks => @frames.map({ "data: $_\n\n" }).List )
				!! %( status => 404, body => '' );
		});
		$!port = $!server.port;
		self;
	}

	method stop(--> Nil) {
		$!server.stop with $!server;
		Nil;
	}
}

sub make-backend(
	EndlessServer $server,
	:$class = LLM::Chat::Backend::OpenAICommon,
	Str :$prefix = '',
) {
	$class.new(
		api_url  => "http://127.0.0.1:{$server.port}{$prefix}/v1",
		settings => LLM::Chat::Backend::Settings.new(max_tokens => 4096),
		template => LLM::Chat::Template::ChatML.new,
	);
}

sub user-turn() {
	[LLM::Chat::Conversation::Message.new(role => 'user', content => 'hi'),]
}

#| Block until $cond is true, or give up after $limit seconds. Returns
#| whether it happened, so a test reads as an assertion rather than as a
#| sleep.
sub happens(&cond, Numeric:D $limit = DISCONNECT-LIMIT --> Bool) {
	my $deadline = now + $limit;
	until cond() {
		return False if now > $deadline;
		sleep 0.005;
	}
	True;
}

#| Wait for the fixture to have pushed at least one frame the client
#| turned into output — i.e. the generation is genuinely under way, so a
#| cancel is cancelling something rather than racing the request.
sub streaming(EndlessServer $server, $resp --> Bool) {
	happens({ $resp.latest.chars > 0 }, 15);
}

subtest 'chat stream: cancel makes the server stop generating' => {
	plan 7;
	my $server = EndlessServer.new.start;
	LEAVE { $server.stop }

	my $backend = make-backend($server);
	my $resp = $backend.chat-completion-stream(user-turn());

	ok streaming($server, $resp), 'the fixture is streaming tokens';

	$backend.cancel($resp);

	ok happens({ so $server.disconnected.status }),
		'the SERVER observed the client hang up';

	# The money assertion: a generation that was stopped produces
	# nothing more. Under the old cosmetic cancel the fixture kept
	# emitting for as long as the test was willing to watch.
	my $at-cancel = $server.emitted;
	sleep 0.5;
	is $server.emitted, $at-cancel,
		'and produced no further tokens in the half-second after';

	ok $resp.is-done,       'the Response is terminal';
	ok $resp.is-cancelled,  'and marked cancelled';
	is ($resp.err // '').Str, 'Cancelled by user',
		'with the cancel as its error, not the transport wreckage';
	nok $resp.error-class.defined,
		'a cancel is not classified as a failure the fallback should retry';
};

subtest 'text stream: cancel makes the server stop generating' => {
	plan 4;
	my $server = EndlessServer.new.start;
	LEAVE { $server.stop }

	my $backend = make-backend($server);
	my $resp = $backend.text-completion-stream(user-turn());

	ok streaming($server, $resp), 'the fixture is streaming tokens';

	$backend.cancel($resp);

	ok happens({ so $server.disconnected.status }),
		'the SERVER observed the client hang up';

	my $at-cancel = $server.emitted;
	sleep 0.5;
	is $server.emitted, $at-cancel, 'and produced no further tokens';

	ok $resp.is-done, 'the Response is terminal';
};

subtest 'blocking completion: cancel mid-body terminates the request' => {
	plan 4;
	# Not every job kind streams. A blocking call sits in `await
	# $res.body-blob` while the server writes, and the same cancel has
	# to reach it — otherwise a non-streaming job cancels on the client
	# and generates to completion upstream exactly as before.
	my $server = EndlessServer.new.start;
	LEAVE { $server.stop }

	my $backend = make-backend($server, prefix => '/blocking');
	my $resp = $backend.chat-completion(user-turn());

	ok happens({ $server.emitted > 2 }, 15),
		'the fixture is writing a body';

	$backend.cancel($resp);

	ok happens({ so $server.disconnected.status }),
		'the SERVER observed the client hang up';

	my $at-cancel = $server.emitted;
	sleep 0.5;
	is $server.emitted, $at-cancel, 'and stopped writing';

	ok $resp.is-done, 'the Response is terminal';
};

subtest 'a cancel raised before response headers still aborts' => {
	plan 4;
	# The case that motivated deferring the abort. A user who cancels
	# during prefill cancels BEFORE there is a Cro response to close —
	# Cro's client exposes no handle on a request in flight — so an
	# abort that only fires when a handle already exists is an abort
	# that never fires at all, which is the whole bug wearing a
	# different hat. The Response remembers the request and aborts on
	# the first byte instead.
	my $server = EndlessServer.new(header-delay => 1.5).start;
	LEAVE { $server.stop }

	my $backend = make-backend($server);
	my $resp = $backend.chat-completion-stream(user-turn());

	# No headers can have arrived yet: the route sleeps 1.5s before it
	# answers at all.
	$backend.cancel($resp);

	ok $resp.is-done,
		'the local close does not wait for the network';
	is $resp.latest, '',
		'and nothing was generated for the consumer';

	ok happens({ so $server.disconnected.status }),
		'the SERVER still observed the hang up, once it had a response to hang up on';

	# Cro attaches the aborter once headers arrive. Test the upstream-stop
	# invariant after the bounded disconnect wait, independent of scheduling.
	my $at-disconnect = $server.emitted;
	sleep 0.5;
	is $server.emitted, $at-disconnect,
		'the server emits no further frames after the deferred abort disconnects';
};

subtest 'cancel after a completed generation is a no-op' => {
	plan 6;
	# A cancel that loses the race to the last token must not turn a
	# finished reply into a failure — and must not reset a connection
	# Cro may since have handed to somebody else.
	my $server = EndlessServer.new.start;
	LEAVE { $server.stop }

	my $backend = make-backend($server);
	my $resp = $backend.chat-completion-stream(user-turn());

	ok streaming($server, $resp), 'the fixture is streaming tokens';
	$backend.cancel($resp);
	ok happens({ $resp.is-done }), 'the stream is cancelled and terminal';

	my $text  = $resp.latest;
	my $err   = ($resp.err // '').Str;

	lives-ok { $backend.cancel($resp) },
		'a second cancel does not throw';
	lives-ok { $resp.cancel; $resp.cancel },
		'nor does a third or fourth, straight on the Response';
	is $resp.latest, $text, 'the accumulated text is untouched';
	is ($resp.err // '').Str, $err, 'and so is the error';
};

subtest 'cancel does not spoil a naturally completed response' => {
	plan 5;
	# Same no-op contract from the other direction: the generation
	# SUCCEEDED, and a late cancel arrives afterwards.
	my $done-server = FinishingServer.new.start;
	LEAVE { $done-server.stop }

	my $backend = LLM::Chat::Backend::OpenAICommon.new(
		api_url  => "http://127.0.0.1:{$done-server.port}/v1",
		settings => LLM::Chat::Backend::Settings.new,
	);
	my $resp = $backend.chat-completion-stream(user-turn());
	ok happens({ $resp.is-done }), 'the stream completes on its own';
	ok $resp.is-success, 'successfully';

	$backend.cancel($resp);

	ok $resp.is-success, 'a cancel afterwards leaves it successful';
	nok $resp.err.defined, 'with no error attached';
	is $resp.latest, 'Once upon a time', 'and the generation intact';
};

subtest 'KoboldCpp keeps its upstream abort AND drops the connection' => {
	plan 4;
	# The one backend with a real abort endpoint must not lose it. The
	# two cover different windows — the POST stops a generation still in
	# prefill, the connection close is instant once a body exists — so
	# this pins both firing, not one replacing the other.
	my $server = EndlessServer.new.start;
	LEAVE { $server.stop }

	my $backend = make-backend($server, class => LLM::Chat::Backend::KoboldCpp);
	my $resp = $backend.chat-completion-stream(user-turn());

	ok streaming($server, $resp), 'the fixture is streaming tokens';

	my $abort = $backend.cancel($resp);
	isa-ok $abort, Promise, 'cancel still returns the background abort handle';

	await Promise.anyof($abort, Promise.in(DISCONNECT-LIMIT));
	ok happens({ $server.abort-count > 0 }),
		'KoboldCpp still got its POST /api/extra/abort';
	ok happens({ so $server.disconnected.status }),
		'and the connection was dropped as well';
};

subtest 'a genuine transport failure is still classified' => {
	plan 3;
	# The guard that keeps a cancel out of the error classifier must not
	# swallow real failures: an unreachable endpoint still has to
	# produce the categorical shape the fallback policy branches on.
	my $probe = IO::Socket::Async.listen('127.0.0.1', 0).tap(-> $ { });
	my $port = await $probe.socket-port;
	$probe.close;

	my $backend = LLM::Chat::Backend::OpenAICommon.new(
		api_url  => "http://127.0.0.1:$port/v1",
		settings => LLM::Chat::Backend::Settings.new,
	);
	my $resp = $backend.chat-completion-stream(user-turn());

	ok happens({ $resp.is-done }, 40), 'the response settles';
	nok $resp.is-success, 'as a failure';
	is $resp.error-class, 'connection',
		'classified as a connection error, cancel guard notwithstanding';
};

done-testing;
