use Test;
use lib 'lib';

use LLM::Chat::Backend::KoboldCpp;
use LLM::Chat::Backend::Settings;
use LLM::Chat::Conversation::Message;
use LLM::Chat::Template::ChatML;

# Terminal finish-reason contract for the STREAMING paths.
#
# When an OAI-compatible server ends a stream with finish_reason
# "length" the generation was cut off by the completion budget. Both
# streaming methods treat that as a failure — error class 'response',
# supply quit — but a consumer that only sees the quit Response cannot
# tell budget exhaustion apart from a content filter or a malformed
# body unless the reason itself is recorded.
#
#   * chat-completion-stream has always stamped it (regression pin).
#   * text-completion-stream did NOT: it acted on $reason and quit
#     without ever calling _set-finish-reason, so .finish-reason came
#     back undefined on exactly the responses that most needed it.
#
# The transport is real Cro over a real socket; only the server is
# canned, so the SSE framing, chunked transfer decoding and the
# backend's own react loop all take part.

plan 4;

# Minimal canned SSE endpoint. Answers any request whose headers have
# arrived with the supplied event bodies, chunk-encoded, then closes.
# Returns the bound port; the tap and every accepted connection are
# closed by the caller's LEAVE.
class SSEServer {
    has $.tap;
    has $.port;
    has @.conns;
    has @.paths;
    has Lock $!lock = Lock.new;

    method start(*@events) {
        my @body = @events;
        $!tap = IO::Socket::Async.listen('127.0.0.1', 0).tap(-> $conn {
            $!lock.protect: { @!conns.push($conn) };
            my Str $seen    = '';
            my Bool $served = False;
            # No `return` in here: the tap block is a Block, not a
            # Routine, and its enclosing method is long gone by the
            # time bytes arrive.
            $conn.Supply(:bin).tap(-> $bytes {
                $seen ~= $bytes.decode('latin-1');
                if !$served && $seen.contains("\r\n\r\n") {
                    $served = True;

                    if $seen ~~ / ^ (\w+) \s+ (\S+) / {
                        $!lock.protect: { @!paths.push(~$1) };
                    }

                    $conn.print(
                        "HTTP/1.1 200 OK\r\n"
                        ~ "Content-Type: text/event-stream\r\n"
                        ~ "Cache-Control: no-cache\r\n"
                        ~ "Transfer-Encoding: chunked\r\n\r\n"
                    );
                    for @body -> $event {
                        my $frame = "data: $event\n\n";
                        $conn.print(
                            $frame.encode('utf-8').bytes.base(16).lc
                            ~ "\r\n" ~ $frame ~ "\r\n"
                        );
                    }
                    $conn.print("0\r\n\r\n");
                }
            });
        });
        $!port = await $!tap.socket-port;
        self;
    }

    method stop() {
        .close for @!conns;
        $!tap.close;
    }
}

sub make-backend(Int $port) {
    LLM::Chat::Backend::KoboldCpp.new(
        api_url  => "http://127.0.0.1:$port/v1",
        settings => LLM::Chat::Backend::Settings.new(max_tokens => 16),
        template => LLM::Chat::Template::ChatML.new,
    );
}

# A stream that produces two content deltas and is then cut off by the
# token budget. `[DONE]` never arrives — a truncated generation ends
# on the finish_reason chunk.
my @chat-events =
    '{"choices":[{"delta":{"content":"Once upon"},"finish_reason":null}]}',
    '{"choices":[{"delta":{"content":" a time"},"finish_reason":null}]}',
    '{"choices":[{"delta":{"content":""},"finish_reason":"length"}]}';

my @text-events =
    '{"choices":[{"text":"Once upon","finish_reason":null}]}',
    '{"choices":[{"text":" a time","finish_reason":null}]}',
    '{"choices":[{"text":"","finish_reason":"length"}]}';

sub await-quit($resp) {
    # The Response's own internal tap records the quit; a second tap
    # just tells us when to stop waiting. Without a quit handler the
    # exception would escape into the test.
    my $p = Promise.new;
    $resp.supply.tap(
        -> $ { },
        done => -> { $p.keep unless $p.status },
        quit => -> $ { $p.keep unless $p.status },
    );
    await Promise.anyof($p, Promise.in(20));
    $p;
}

subtest 'chat-completion-stream records finish_reason length' => {
    plan 5;
    my $server = SSEServer.new.start(@chat-events);
    LEAVE { $server.stop }

    my $backend = make-backend($server.port);
    my $resp = $backend.chat-completion-stream(
        [LLM::Chat::Conversation::Message.new(role => 'user', content => 'hi')],
    );
    my $p = await-quit($resp);

    ok $p.status ~~ Kept,        'stream terminated';
    ok $resp.is-done,            'response is done';
    nok $resp.is-success,        'a truncated stream is not a success';
    is $resp.error-class, 'response',
        'budget exhaustion classifies as a response-level error';
    is $resp.finish-reason, 'length',
        'finish-reason names the terminal cause';
};

subtest 'chat-completion-stream keeps the partial generation' => {
    plan 2;
    my $server = SSEServer.new.start(@chat-events);
    LEAVE { $server.stop }

    my $backend = make-backend($server.port);
    my $resp = $backend.chat-completion-stream(
        [LLM::Chat::Conversation::Message.new(role => 'user', content => 'hi')],
    );
    await-quit($resp);

    is $resp.latest, 'Once upon a time',
        'tokens emitted before the cut-off are retained';
    is $server.paths[0], '/v1/chat/completions',
        'request went to the chat-completions endpoint';
};

subtest 'text-completion-stream records finish_reason length' => {
    plan 5;
    # The regression: this path acted on the reason but never stamped
    # it, so consumers saw a quit Response with an undefined
    # finish-reason and no way to tell budget exhaustion from a
    # content filter.
    my $server = SSEServer.new.start(@text-events);
    LEAVE { $server.stop }

    my $backend = make-backend($server.port);
    my $resp = $backend.text-completion-stream(
        [LLM::Chat::Conversation::Message.new(role => 'user', content => 'hi')],
    );
    my $p = await-quit($resp);

    ok $p.status ~~ Kept,        'stream terminated';
    ok $resp.is-done,            'response is done';
    nok $resp.is-success,        'a truncated stream is not a success';
    is $resp.error-class, 'response',
        'budget exhaustion classifies as a response-level error';
    is $resp.finish-reason, 'length',
        'finish-reason names the terminal cause';
};

subtest 'text-completion-stream keeps the partial generation' => {
    plan 2;
    my $server = SSEServer.new.start(@text-events);
    LEAVE { $server.stop }

    my $backend = make-backend($server.port);
    my $resp = $backend.text-completion-stream(
        [LLM::Chat::Conversation::Message.new(role => 'user', content => 'hi')],
    );
    await-quit($resp);

    is $resp.latest, 'Once upon a time',
        'tokens emitted before the cut-off are retained';
    is $server.paths[0], '/v1/completions',
        'request went to the completions endpoint';
};

done-testing;
